# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # SOLO servidor. Nunca exponer.

# Riot (developer.riotgames.com). La dev key vence cada 24 h.
RIOT_API_KEY=
RIOT_REGION=americas              # routing regional (account-v1, match-v5)
RIOT_PLATFORM_DEFAULT=la2         # la2 = LAS, la1 = LAN, br1 = BR, na1 = NA

# Gemini (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=                     # el modelo flash vigente; se configura acá para no hardcodearlo
GEMINI_MODEL_FALLBACKS=           # opcional: "modelo-b,modelo-c". Se prueban en orden si el principal da 503/429/404
GEMINI_MOCK=false                # true = no llama a Gemini: devuelve ejemplos válidos (no gasta cuota)

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEMO_MODE=false                   # true = si la Riot API falla, se sirve lo cacheado sin intentar refrescar
